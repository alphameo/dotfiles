{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode/big-pickle",
    "autoupdate": true,
    "permission": {
        "*": "allow",
        "edit": "ask",
        "bash": {
            "*": "ask",
            "ls *": "allow",
            "find *": "allow",
            "fd *": "allow",
            "head *": "allow",
            "echo *": "allow",
            "grep *": "allow",
            "rg *": "allow",
            "sort *": "allow",
            "cat *": "allow",
            "bat *": "allow",
            "wc *": "allow",
        }
    },
}
