// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "search": {
    "button": false
  },
  "git_panel": {
    "dock": "left"
  },
  "scrollbar": {
    "axes": {
      "horizontal": false
    }
  },
  "sticky_scroll": {
    "enabled": true
  },
  "preferred_line_length": 100,
  "ui_font_size": 16.0,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "markdown_preview": {
    "open_markdown_files_in_preview": false,
    "font_size": 14.0
  },
  "agent_buffer_font_size": 14.0,
  "restore_on_startup": "empty_tab",
  "on_new_window": "empty_tab",
  "base_keymap": "Zed",
  "cursor_animation": {
    "enabled": true
  },
  "icon_theme": "Material Icon Theme",
  "outline_panel": {
    "button": false
  },
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "collaboration_panel": {
    "button": false
  },
  "debugger": {
    "dock": "left"
  },
  "bottom_dock_layout": "contained",
  "hover_popover_enabled": false,
  "show_completion_documentation": true,
  "proxy": "",
  "zoomed_padding": true,
  "use_system_window_tabs": false,
  "centered_layout": {
    "left_padding": 0.2
  },
  "preview_tabs": {
    "enabled": false
  },
  "tabs": {
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "show_worktree_name": false,
    "show_project_items": true,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false,
    "show_user_menu": true,
    "button_layout": "platform_default",
    "show_menus": false,
    "show_branch_status_icon": true
  },
  "status_bar": {
    "show_active_file": true,
    "pending_keystrokes_indicator": true,
    "line_endings_button": false,
    "cursor_position_button": true,
    "active_language_button": true
  },
  "go_to_definition_fallback": "none",
  "inlay_hints": {
    "enabled": true
  },
  "completion_menu_item_kind": "symbol",
  "show_whitespaces": "selection",
  "ensure_final_newline_on_save": false,
  "indent_guides": {
    "coloring": "fixed",
    "active_line_width": 2,
    "line_width": 2
  },
  "minimap": {
    "show": "never"
  },
  "gutter": {
    "folds": false,
    "bookmarks": false,
    "min_line_number_digits": 3,
    "breakpoints": true,
    "runnables": false
  },
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "accessible_mode": false,
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true
  },
  "which_key": {
    "enabled": true
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "project_panel": {
    "diagnostic_badges": true,
    "button": true,
    "dock": "left"
  },
  "toolbar": {
    "agent_review": false,
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": false
  },
  "terminal": {
    "button": true,
    "font_weight": 400.0,
    "font_size": 14.0,
    "font_family": "JetBrainsMono Nerd Font Mono"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark Pro",
  },
}
