[
	{
		"context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
		"bindings": {
			// put key-bindings here if you want them to work in normal & visual mode
			// Git
			"space g h d": "editor::ToggleSelectedDiffHunks",
			"space g g": "git_panel::ToggleFocus",
			// Toggle inlay hints
			"space t i": "editor::ToggleInlayHints",
			// Toggle soft wrap
			"space u w": "editor::ToggleSoftWrap",
			// NOTE: Toggle Zen mode, partially with nvim plugin like no-neck-pain
			"space c z": "workspace::ToggleCenteredLayout",
			// Open markdown preview
			"space l p": "markdown::OpenPreview",
			"space l P": "markdown::OpenPreviewToTheSide",
			// Open recent project
			"space f p": "projects::OpenRecent",
			// Search word under cursor
			"space f w": "pane::DeploySearch",
			// Go to file with `gf`
			"g f": "editor::OpenExcerpts",
		},
	},
	{
		"context": "Editor && vim_mode == normal && !VimWaiting && !menu",
		"bindings": {
			// put key-bindings here if you want them to work only in normal mode
			// Ctrl hjkl to move between panes
			"ctrl-h": "workspace::ActivatePaneLeft",
			"ctrl-l": "workspace::ActivatePaneRight",
			"ctrl-k": "workspace::ActivatePaneUp",
			"ctrl-j": "workspace::ActivatePaneDown",
			// LSP
			"g r a": "editor::ToggleCodeActions",
			"space .": "editor::ToggleCodeActions",
			"g r n": "editor::Rename",
			"g Q": "editor::Format",
			"g r d": "editor::GoToDefinition",
			"g r D": "editor::GoToDefinitionSplit",
			"g r i": "editor::GoToImplementation",
			"g r I": "editor::GoToImplementationSplit",
			"g r t": "editor::GoToTypeDefinition",
			"g r T": "editor::GoToTypeDefinitionSplit",
			"g r r": "editor::FindAllReferences",
			"] d": "editor::GoToDiagnostic",
			"[ d": "editor::GoToPreviousDiagnostic",
			// Symbol search
			"g O": "outline::Toggle",
			"g o": "project_symbols::Toggle",
			// Diagnostic
			"g f d": "diagnostics::Deploy",
			// Git
			// Git prev/next hunk
			"] h": "editor::GoToHunk",
			"[ h": "editor::GoToPreviousHunk",
			// Git project diff
			"space g d": "git::Diff",
			// Toggle inline blame
			"space g b": "editor::ToggleGitBlameInline",
			// Expand all diff hunks
			"space g h e": "editor::ExpandAllDiffHunks",
			// Buffers
			// Switch between buffers
			"[b": "pane::ActivatePreviousItem",
			"]b": "pane::ActivateNextItem",
			"ctrl-p": "pane::ActivatePreviousItem",
			"ctrl-n": "pane::ActivateNextItem",
			// Close active panel
			"ctrl-w q": "pane::CloseActiveItem",
			// Buffer switch alias
			"ctrl-backspace": "pane::ActivatePreviousItem",
			// Close other items
			"ctrl-w o": "pane::CloseOtherItems",
			// File finder
			"space f f": "file_finder::Toggle",
			// Project search
			"space f g": "text_finder::Toggle",
			// Show project panel with current file
			"space e": "pane::RevealInProjectPanel",
			// Move lines up/down
			"alt-k": "editor::MoveLineUp",
			"alt-j": "editor::MoveLineDown",
			// Window management
			"space w w": "workspace::ActivatePreviousPane",
			"ctrl-w s": "pane::SplitDown",
			"ctrl-w v": "pane::SplitRight",
			// Window resize
			"ctrl-equal": "vim::ResizePaneUp",
			"ctrl-minus": "vim::ResizePaneDown",
			"ctrl-comma": "vim::ResizePaneLeft",
			"ctrl-period": "vim::ResizePaneRight",
			// Close tab
			"ctrl-q": ["pane::CloseActiveItem", { "close_pinned": false }],
		},
	},
	// Empty pane, set of keybindings that are available when there is no active editor
	{
		"context": "EmptyPane || SharedScreen",
		"bindings": {
			// Open file finder
			"space f f": "file_finder::Toggle",
			// Open recent project
			"space f p": "projects::OpenRecent",
			// Open AI chat
			"space a c": "agent::ToggleFocus",
			// FFF GUI, refer https://github.com/th0jensen/fff-gpui#configuration
			// "space f f": [
			// 	"task::Spawn",
			// 	{
			// 		"task_name": "fff-gpui: Files",
